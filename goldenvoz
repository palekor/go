  chunk:b=>{ST.c=+b.dataset.n;render();A.say(W[ST.i].cols[ST.c])},
  frame:b=>{const ta=$("#line"),f=FRAMES[+b.dataset.n];let v=ta.value.trim();if(v)v=v[0].toLowerCase()+v.slice(1);ta.value=f+v;ST.text=ta.value;updMeter();ta.focus()},
  conn:b=>{const ta=$("#line");ta.value=ta.value.trim().replace(/[.!?]+$/,"")+(/,$/.test(ta.value.trim())?" ":", ")+b.dataset.t+" ";ST.text=ta.value;updMeter();ta.focus()},
  hear:b=>{if(b.classList.contains("on")){A.stop();return}const t=$("#line").value.trim();if(!t){toast("Write your line first");return}A.say(t,b)},
  saveline:()=>{const t=$("#line").value.trim(),w=W[ST.i];const k=karat(t,w,w.cols[ST.c]);if(k<2){toast("Use your chunk first, then save");return}
    P.lines.unshift({t,w:w.w,k});P.lines=P.lines.slice(0,60);P.k+=k;save();ST.text="";render();toast("Saved at "+KT[k-1]);A.say(t)},
  del:b=>{P.lines.splice(+b.dataset.n,1);save();render()},
  copyall:()=>copy(allLines()),
  share:()=>{navigator.share({text:allLines()}).catch(()=>{})},
  copyspeech:()=>copy(speechText())
};
document.addEventListener("click",e=>{const nv=e.target.closest("nav [data-v]");if(nv){go(nv.dataset.v);return}
  const b=e.target.closest("[data-a]");if(b&&ACT[b.dataset.a])ACT[b.dataset.a](b)});
document.addEventListener("input",e=>{if(e.target.id==="q"){S.q=e.target.value;S.open=-1;$("#list").innerHTML=listHTML()}
  if(e.target.id==="line"){ST.text=e.target.value;updMeter()}});
document.addEventListener("change",e=>{const c=e.target.dataset.c;if(c==="dsuite")S.suite=e.target.value;if(c==="sword"){ST.i=+e.target.value;ST.c=0;render()}});
document.addEventListener("submit",e=>{if(e.target.dataset.f!=="dict")return;e.preventDefault();const w=DR.items[DR.k],v=norm($("#din").value);if(!v)return;
  if(v===norm(w.ph)){DR.ans=true;if(!DR.miss)DR.ok++;DR.fb=DR.miss?"There it is.":"Exactly.";DR.fbc="good";render();A.say(w.s)}
  else{DR.miss++;if(DR.miss>=2){DR.ans=true;DR.fb="Read it, hear it once more, and say it aloud.";DR.fbc="bad";render();A.say(w.s)}
    else{DR.fb="Close. Listen again and check every word.";DR.fbc="bad";$(".fb").textContent=DR.fb;$(".fb").className="fb bad";A.say(w.s,$("#auto"))}}});
render();
</script>

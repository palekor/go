.tile{padding:10px 14px;border-radius:12px;border:1px solid var(--hair);background:var(--panel2);font-family:var(--serif);font-size:1.02rem}
.tile.in{border-color:var(--gold);color:var(--gold2)}
.fb{min-height:26px;text-align:center;margin-top:16px;font-weight:600}
.fb.good{color:var(--ok)} .fb.bad{color:var(--err)}

function segs(w){const x=w.x,lx=x.toLowerCase(),core=w.s.replace(/[.!?]$/,"");const j=lx.indexOf(core.toLowerCase()),i=lx.indexOf(w.ph.toLowerCase());
  let cuts=[0,x.length];if(j>0)cuts.push(j);if(i>=0)cuts.push(i,i+w.ph.length);if(j>=0)cuts.push(j+core.length);
  cuts=[...new Set(cuts)].sort((a,b)=>a-b);let parts=[];
  for(let n=0;n<cuts.length-1;n++){let p=x.slice(cuts[n],cuts[n+1]).trim();if(!p)continue;const m=p.match(/^[,.;!?]+/);
    if(m&&parts.length){parts[parts.length-1]+=m[0];p=p.slice(m[0].length).trim()}if(p)parts.push(p)}
  const out=[];parts.forEach(p=>{const ws=p.split(" ");if(ws.length>6){const c=p.indexOf(", ");
    if(c>6&&c<p.length-8)out.push(p.slice(0,c+1),p.slice(c+2));else{const h=Math.ceil(ws.length/2);out.push(ws.slice(0,h).join(" "),ws.slice(h).join(" "))}}else out.push(p)});
  return out}
function startDrill(id){const pool=S.suite==="All"?W:W.filter(w=>w.cat===S.suite);DR={id,items:shuffle(pool).slice(0,8),k:0,ok:0,done:false};setItem()}
function setItem(){const w=DR.items[DR.k];Object.assign(DR,{ans:false,miss:0,fb:"",fbc:"",chosen:-1,shake:false});

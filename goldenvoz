@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.field{display:flex;gap:8px;margin-top:16px}
.field input{flex:1;min-width:0;min-height:48px;border-radius:14px;border:1px solid var(--hair);background:rgba(243,238,223,.05);padding:10px 14px;font-family:var(--serif);font-size:1.05rem}
.result b{display:block;font-family:var(--serif);font-weight:800;font-size:4rem;line-height:1}

/* studio */
.lab{display:block;font-weight:700;font-size:.9rem;color:var(--gold2);margin:20px 0 9px}
.lab:first-child{margin-top:0}
select{min-height:46px;border-radius:14px;border:1px solid var(--hair);background:var(--navy2);padding:8px 12px;flex:1;min-width:0}
textarea{width:100%;min-height:118px;border-radius:16px;border:1px solid var(--hair);background:rgba(10,15,30,.55);padding:14px;font-family:var(--serif);font-size:1.15rem;line-height:1.4;resize:vertical;margin:10px 0}
.meter{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;margin-top:6px}
.meter span{height:28px;border-radius:7px;border:1px solid var(--hair2);display:grid;place-items:center;font-family:var(--serif);font-size:.74rem;font-weight:600;color:var(--dim)}
.meter span.lit{background:rgba(216,178,74,.16);border-color:var(--gold);color:var(--gold2)}
.meter span.lit.full{background:linear-gradient(180deg,#E7C766,#C79F36);color:#1B1403;border-color:transparent}
#tip{margin:10px 0 16px;color:#CFCBBE;font-size:.95rem;min-height:1.5em}
.line{display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:center;padding:13px 0;border-bottom:1px solid var(--hair2)}
.line p{font-family:var(--serif);font-size:1.05rem;line-height:1.35}
.line small{color:var(--mute);font-size:.78rem}
.x{width:36px;height:36px;border-radius:50%;color:var(--dim);font-size:1.1rem}
.speech{font-family:var(--serif);font-size:1.1rem;line-height:1.5;color:#E6E1D2;margin:10px 0 16px}
footer{padding:26px 0 10px;text-align:center;color:var(--dim);font-size:.82rem}
footer a{color:var(--gold)}
#toast{position:fixed;left:50%;bottom:calc(100px + env(safe-area-inset-bottom));transform:translateX(-50%);background:var(--ivory);color:var(--navy);padding:9px 16px;border-radius:999px;font-weight:600;font-size:.88rem;opacity:0;pointer-events:none;transition:opacity .2s;z-index:30}
#toast.show{opacity:1}
@media(min-width:760px){
  body{padding-bottom:40px}
  nav{position:sticky;top:0;bottom:auto;border-top:0;border-bottom:1px solid var(--hair)}
  nav button{flex-direction:row;justify-content:center;gap:8px}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>

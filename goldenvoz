  if(DR.id==="match"){let pool=W.filter(o=>o!==w&&o.pos===w.pos);DR.opts=shuffle([w,...shuffle(pool).slice(0,3)])}
  if(DR.id==="build"){const t=segs(w).map((t,n)=>({t,n}));let sh=shuffle(t);if(t.length>1&&sh.every((o,n)=>o.n===n))sh.push(sh.shift());DR.tiles=sh;DR.pick=[]}}

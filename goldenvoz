h3{font-family:var(--serif);font-weight:600;font-size:1.2rem;line-height:1.2;margin-bottom:6px}
.gilt{background:linear-gradient(100deg,#B08A2C 0%,#F3DFA0 38%,#D8B24A 62%,#FFF4CF 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.lede{color:#D5D2C6;font-size:1.04rem;max-width:58ch}
.es{color:var(--mute);font-family:var(--serif);font-style:italic;font-size:.95rem}

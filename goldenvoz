  _u(text,end){const my=A.tok;const u=new SpeechSynthesisUtterance(text);u.lang="en-US";if(A.voice)u.voice=A.voice;u.rate=A.rate();
    let done=false;const fin=()=>{if(done)return;done=true;if(my===A.tok&&end)end()};u.onend=fin;u.onerror=fin;speechSynthesis.speak(u)},
  say(text,btn,end){if(!A.ok())return;const busy=speechSynthesis.speaking||speechSynthesis.pending;A.stop();A.btn=btn||null;if(btn)btn.classList.add("on");
    const run=()=>A._u(text,()=>{A.clear();if(end)end()});if(busy){const my=A.tok;setTimeout(()=>{if(my===A.tok)run()},70)}else run()},
  seq(list,btn,step,end){if(!A.ok())return;A.stop();A.btn=btn||null;if(btn)btn.classList.add("on");const my=A.tok;

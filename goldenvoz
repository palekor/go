.btn.ghost{background:transparent;color:var(--gold2);border:1px solid var(--hair);box-shadow:none}
.btn.sm{min-height:38px;padding:7px 14px;font-size:.85rem}
.btn.on{background:var(--ivory);color:var(--navy)}
.row{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.play{flex:none;width:40px;height:40px;border-radius:50%;border:1px solid var(--hair);color:var(--gold2);display:grid;place-items:center;background:rgba(216,178,74,.06)}

      <p style="margin-top:18px"><button class="chip s" data-a="quit">Back to the atelier</button></p></section>`}
  const w=DR.items[DR.k];let body="";
  const optBtn=(o,label)=>{let c="";if(DR.ans){if(o.i===w.i)c=" good";else if(o.i===DR.chosen)c=" bad"}return`<button class="opt${c}" data-a="pick" data-i="${o.i}"${DR.ans?" disabled":""}>${esc(label)}</button>`};
  if(DR.id==="ear")body=`<div class="center"><button class="bigplay" id="auto" data-a="say" data-t="${esc(w.cols[0])}" aria-label="Hear the chunk">${ICON(30)}</button><p class="mute">Tap to hear it again</p></div>
    <div class="opts">${DR.opts.map(o=>optBtn(o,o.cols[0])).join("")}</div>`;

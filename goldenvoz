.bigplay{width:84px;height:84px;border-radius:50%;border:1px solid var(--gold);color:var(--gold2);display:grid;place-items:center;margin:6px auto 8px;background:radial-gradient(circle at 50% 35%,rgba(216,178,74,.22),rgba(216,178,74,.04))}

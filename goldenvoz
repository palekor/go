.rung:last-child{border-bottom:0}
.kt{position:absolute;left:-20px;top:50%;transform:translateY(-50%);width:40px;height:24px;border-radius:6px;display:grid;place-items:center;
  font-family:var(--serif);font-weight:600;font-size:.72rem;background:var(--navy);border:1px solid var(--hair);color:var(--gold)}
.rung[data-k="1"] .kt{border-color:rgba(216,178,74,.35)}
.rung[data-k="2"] .kt{border-color:rgba(216,178,74,.5)}
.rung[data-k="3"] .kt{border-color:rgba(216,178,74,.75);color:var(--gold2)}
.rung[data-k="4"] .kt{background:linear-gradient(180deg,#E7C766,#C79F36);color:#1B1403;border-color:transparent}
.rung small{display:block;font-size:.72rem;color:var(--dim);font-weight:600;margin-bottom:1px}
.rung p{font-family:var(--serif);font-size:1.08rem;line-height:1.35;color:var(--mute)}
.rung p b{font-weight:600;color:var(--gold2)}
.rung[data-k="0"] p{font-size:1.5rem;font-weight:800}
.rung.live{background:linear-gradient(90deg,rgba(216,178,74,.12),transparent)}
.rung.live p{color:var(--ivory)}
.more{margin-top:14px}
.more small{display:block;color:var(--dim);font-size:.78rem;font-weight:600;margin-bottom:7px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{padding:8px 14px;border-radius:999px;border:1px solid var(--hair2);background:rgba(243,238,223,.04);font-size:.9rem;color:var(--ivory)}
.chip.on,.chip.sel{border-color:var(--gold);color:var(--gold2);background:rgba(216,178,74,.10)}
.chip.s{font-size:.82rem;padding:6px 12px;color:var(--mute)}

/* panels */
.panel{background:linear-gradient(180deg,var(--panel),var(--navy2));border:1px solid var(--hair);border-radius:22px;padding:20px 18px}
.idea{padding:16px 0;border-bottom:1px solid var(--hair2)}
.idea:last-child{border-bottom:0}
.idea p{color:#CFCBBE}
.steps{counter-reset:s;list-style:none}
.steps li{counter-increment:s;position:relative;padding:12px 0 12px 46px;border-bottom:1px solid var(--hair2)}
.steps li:last-child{border-bottom:0}
.steps li::before{content:counter(s);position:absolute;left:0;top:12px;width:30px;height:30px;border-radius:50%;border:1px solid var(--hair);display:grid;place-items:center;font-family:var(--serif);font-weight:600;color:var(--gold)}
.steps b{color:var(--gold2)}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.stat{border:1px solid var(--hair2);border-radius:16px;padding:14px 10px;text-align:center}
.stat b{display:block;font-family:var(--serif);font-weight:800;font-size:1.7rem;color:var(--gold2);line-height:1.1}
.stat span{font-size:.78rem;color:var(--mute)}

/* collection */
.suites{display:flex;gap:8px;overflow-x:auto;padding:4px 18px 10px;margin:0 -18px;scrollbar-width:none}
.suites::-webkit-scrollbar{display:none}
.suites .chip{flex:none}
.search{width:100%;min-height:46px;border-radius:14px;border:1px solid var(--hair2);background:rgba(243,238,223,.04);padding:10px 14px;margin:6px 0 10px}
.search::placeholder,textarea::placeholder{color:var(--dim)}
.wrow{border-bottom:1px solid var(--hair2);display:grid;grid-template-columns:1fr auto;align-items:center;column-gap:10px}
.whead{text-align:left;padding:14px 0;display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 12px;min-width:0}
.wn{font-family:var(--serif);font-weight:600;font-size:1.3rem;letter-spacing:-.01em}
.wm{color:var(--mute);font-size:.86rem}
.pol{color:var(--gold);font-size:.8rem}
.wrow.open{border:1px solid var(--hair);border-radius:20px;padding:4px 14px 16px;margin:10px -6px;background:linear-gradient(180deg,var(--panel),var(--navy2))}
.wrow.open .wn{color:var(--gold2);font-size:1.6rem}
.wrow.open .wm{display:none}
.wrow .lad{grid-column:1/-1;margin-top:0}

/* drills */
.dcard{display:grid;grid-template-columns:auto 1fr;gap:4px 14px;align-items:center;width:100%;text-align:left;padding:16px 0;border-bottom:1px solid var(--hair2)}
.dcard .kt{position:static;transform:none;width:48px;height:30px;font-size:.82rem;grid-row:span 2}
.dcard h3{margin:0}
.dcard p{grid-column:2;color:var(--mute);font-size:.92rem}
.dcard .best{color:var(--gold);font-size:.8rem;font-weight:600}
.dtop{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font-size:.88rem;color:var(--mute)}
.bar{height:4px;border-radius:4px;background:var(--hair2);overflow:hidden;margin-bottom:22px}
.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--gold3),var(--gold2));transition:width .3s}
.center{text-align:center}
.prompt{font-family:var(--serif);font-size:1.45rem;line-height:1.35;text-align:center;margin:10px 0}
.blank{display:inline-block;min-width:110px;border-bottom:2px solid var(--gold);color:var(--gold2);padding:0 6px}
.opts{display:grid;gap:10px;margin-top:18px}
.opt{min-height:52px;padding:13px 16px;border-radius:16px;border:1px solid var(--hair2);background:rgba(243,238,223,.04);font-family:var(--serif);font-size:1.1rem;text-align:left}
.opt.good{border-color:var(--ok);color:var(--ok);background:rgba(95,211,179,.08)}
.opt.bad{border-color:var(--err);color:var(--err)}
.opt:disabled{cursor:default}
.tray{min-height:62px;display:flex;flex-wrap:wrap;gap:8px;padding:12px;border-radius:16px;margin-top:12px;justify-content:center;align-items:center}

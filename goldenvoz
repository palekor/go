const FRAMES=["My goal is to ","In my business, ","This year, I will ","I admire people who ","What I have learned is that ","My clients trust me because "];
const CONNS=["because","so that","even though","which means","as long as","instead of"];
const CONN_RE=/\b(because|so that|so|although|even though|even when|even if|which|while|since|as long as|instead of|rather than|unless|if|when|whenever|before|after|but|yet|provided that|otherwise|once)\b/;
const stem=t=>{t=t.toLowerCase().replace(/[^a-z]/g,"");return t.length>5?t.slice(0,Math.max(4,t.length-3)):t.slice(0,Math.max(3,t.length-1))};
const STOP=["your","with","into","over","the","for","and","her","his","its","than"];
function karat(text,w,chunk){const n=norm(text);if(!n||!n.includes(stem(w.w)))return 0;let k=1;const words=n.split(" ").length;
  const keys=chunk.split(" ").filter(t=>t.length>2&&!STOP.includes(t.toLowerCase()));
  if(keys.every(t=>n.includes(stem(t))))k=2;else return k;
  if(words>=4)k=3;else return k;
  if(words>=7&&/[.!?]$/.test(text.trim()))k=4;else return k;
  if(words>=12&&CONN_RE.test(n))k=5;return k}
function tipFor(k,w,chunk){return[

nav .in{max-width:720px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
nav button{padding:10px 4px 9px;border-radius:12px;font-size:.82rem;font-weight:600;color:var(--mute);display:flex;flex-direction:column;align-items:center;gap:3px}
